{
  "name": "ai-burnrate-tool",
  "version": "1.0.0",
  "description": "Real-time local token & API equivalent cost tracker for Antigravity CLI and Claude Code",
  "type": "module",
  "bin": {
    "burnrate": "dist/cli/index.js",
    "ai-burnrate": "dist/cli/index.js",
    "ai-burnrate-tool": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "config",
    "scripts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cise07/ai-burnrate-tool.git"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "npm run build:web && npm run build:cli",
    "setup": "npm install && npm run build && npm install -g .",
    "remove": "npm uninstall -g ai-burnrate-tool",
    "start": "node ./dist/cli/index.js"
  },
  "keywords": [
    "ai",
    "tokens",
    "burnrate",
    "claude-code",
    "antigravity",
    "gemini",
    "cost-tracker",
    "cli"
  ],
  "author": "Cise07",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
