{
  "name": "ai-burnrate-tool",
  "version": "1.4.0",
  "description": "Real-time local token & API equivalent cost tracker for Antigravity CLI, Claude Code and Codex CLI",
  "type": "module",
  "bin": {
    "burn": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "config",
    "scripts",
    "README.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cise07/ai-burnrate-tool.git"
  },
  "scripts": {
    "dev:web": "vite",
    "clean:cli": "node -e \"const fs=require('node:fs');for(const d of ['dist/cli','dist/core','dist/server'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build:web": "vite build",
    "build:cli": "npm run clean:cli && tsc -p tsconfig.cli.json",
    "build": "npm run build:web && npm run build:cli",
    "test": "npm run build:cli && node --test tests/quota/*.test.mjs tests/security/*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "npm install && npm run build && npm install -g .",
    "remove": "npm uninstall -g ai-burnrate-tool",
    "start": "node ./dist/cli/index.js"
  },
  "keywords": [
    "ai",
    "tokens",
    "burn",
    "burnrate",
    "claude-code",
    "antigravity",
    "codex",
    "openai",
    "gemini",
    "cost-tracker",
    "cli"
  ],
  "author": "Cise07",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.4.6"
  }
}
